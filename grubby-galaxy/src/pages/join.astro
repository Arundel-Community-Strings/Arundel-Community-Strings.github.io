---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

---

<Layout>
<div class="content-page-container">
  <div class="grid-container">
    <h1>Stuff to Know Before Joining</h1>

    <h2>Important Dates and Locations</h2>
    <div
      class="usa-summary-box"
      role="region"
      aria-labelledby="summary-box-key-information"
    >
      <div class="usa-summary-box__body">
        <div class="usa-summary-box__text">

        <h4 class="usa-summary-box__heading">Location</h4>
          <p>Parking and Entrance are <span class="emphasis-dark">in the Rear</span></p>
          <ul class="usa-list">
            <li>The lounge at <a href="https://maps.app.goo.gl/BqAAvER6icm3LPa49">
            Harundale Presbyterian Church</a></li>
            <li>1020 Eastway, Glen Burnie, MD 21060 </li>
          </ul>

        <h4 class="usa-summary-box__heading">Regular Rehearsals</h4>
          <ul class="usa-list">
            <li>First 7 Weeks</li>
            <li>Friday evenings from 6:00pm - 7:30pm</li>
          </ul>

        <h4 class="usa-summary-box__heading">Dress Rehearsal / Concert</h4>
          <ul class="usa-list">
            <li>Week 8</li>
            <li>Call time: Friday evening 5:30pm</li>
            <li><span class="emphasis-dark">Concert:</span> 7:00pm</li>
          </ul>
        </div>
      </div>
    </div>

    <h2>Registration Steps</h2>
    <ol class="usa-process-list">
      <li class="usa-process-list__item">
        <h4 class="usa-process-list__heading">Complete the Online Form</h4>
        <p class="margin-top-05">
          <a href="https://forms.gle/zvmAaGue9pFDoUsq9">Registration Form</a>
        </p>
      </li>
      <li class="usa-process-list__item">
        <h4 class="usa-process-list__heading">Submit Your Fee</h4>
        <p class="margin-top-05">
        A registration fee of $75 is due no later than 1 week before the first rehearsal of each session
        </p>
        <p>We accept the following methods of payment:
          <ul>
            <li><a href="https://paypal.me/jendanko">PayPal to Jennifer Danko</a> (please use Friends and Family)</li>
            <li><a href="https://venmo.com/u/LovelyWench">Venmo to Jennifer Danko</a></li>
            <li>
              Check made out to "Jennifer Danko"
              <p>Send checks via US Mail to:</p>
              <p>
                Jennifer Danko<br />
                303 Nicole Ln.<br />
                Glen Burnie, MD 21061<br />
              </p>
            </li>
          </ul>

        </p>
      </li>
    </ol>
  </div>
</div>
</Layout>
